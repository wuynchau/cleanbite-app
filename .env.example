# Frontend (Vite). Publishable values are visible to browsers; never put secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
VITE_GEMINI_MODEL=gemini-3.6-flash

# Server-side API (Vercel / npx vercel dev). Use the same Supabase project values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Test mode only sends to the email associated with your Resend account.
# For users' email addresses, verify your own sending domain in Resend and use an address on it.
RESEND_FROM_EMAIL=CleanBite <onboarding@resend.dev>
